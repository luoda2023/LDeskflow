/* LDeskflow Dark theme
 * Periwinkle palette derived from the LDeskflow icon.
 * Applied on top of the Fusion style for a consistent cross-platform look.
 */

/* ---- Application surfaces ------------------------------------------- */
QMainWindow, QDialog, QMessageBox, QWizard {
  background-color: #1a1a22;
  color: #ededf5;
}
QWidget { color: #ededf5; font-size: 13px; }

/* ---- Labels & text -------------------------------------------------- */
QLabel { background: transparent; }
QLabel[class~="muted"] { color: #9a9ab0; }
QLabel#lblName { color: #b9adf5; font-weight: 600; }
QLabel#lblDescription, QLabel#lblVersion { color: #9a9ab0; }

/* ---- Buttons --------------------------------------------------------- */
QPushButton {
  background-color: #2a2a36;
  color: #ededf5;
  border: 1px solid #48485c;
  border-radius: 6px;
  padding: 5px 14px;
  min-height: 18px;
}
QPushButton:hover { background-color: #38384a; border-color: #6f66c9; }
QPushButton:pressed { background-color: #33334a; }
QPushButton:focus { border-color: #8b7be8; outline: none; }
QPushButton:disabled { color: #62627a; background-color: #23232d; border-color: #34343f; }

QPushButton:default {
  background-color: #8b7be8;
  color: #ffffff;
  border: 1px solid #8b7be8;
  font-weight: 600;
}
QPushButton:default:hover { background-color: #9c8eed; border-color: #9c8eed; }
QPushButton:default:pressed { background-color: #7766db; border-color: #7766db; }
QPushButton:default:focus { border: 2px solid #8f83ea; }
QPushButton:default:disabled { background-color: #4c4670; border-color: #4c4670; color: #9b95c9; }

QPushButton[danger="true"] { color: #f29b96; border-color: #a54b46; }
QPushButton[danger="true"]:hover { background-color: #42272b; }

QToolButton {
  background-color: transparent;
  color: #ededf5;
  border: none;
  border-radius: 6px;
  padding: 3px;
}
QToolButton:hover { background-color: #34334a; }
QToolButton:pressed { background-color: #43406a; }
QToolButton:disabled { color: #5a5a72; }

/* ---- Inputs ---------------------------------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox,
QComboBox, QDateTimeEdit, QFontComboBox, QKeySequenceEdit {
  background-color: #23232f;
  color: #ededf5;
  border: 1px solid #3f3f53;
  border-radius: 6px;
  padding: 4px 8px;
  selection-background-color: #8b7be8;
  selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QComboBox:focus, QDateTimeEdit:focus,
QFontComboBox:focus, QKeySequenceEdit:focus {
  border: 1px solid #8b7be8;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QTextEdit:disabled, QPlainTextEdit:disabled {
  background-color: #21212b;
  color: #5a5a72;
  border-color: #34343f;
}
QLineEdit[readOnly="true"] { background-color: #20202a; color: #9a9ab0; }

QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
  background-color: #23232f;
  border: 1px solid #3f3f53;
  border-radius: 6px;
  padding: 4px;
  selection-background-color: #8b7be8;
  selection-color: #ffffff;
  outline: none;
}
QAbstractSpinBox { padding-right: 6px; }

/* ---- Check & radio --------------------------------------------------- */
QCheckBox, QRadioButton { spacing: 6px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QCheckBox:disabled, QRadioButton:disabled { color: #5a5a72; }

/* ---- Group boxes ------------------------------------------------------ */
QGroupBox {
  background-color: #1f1f2a;
  border: 1px solid #32323f;
  border-radius: 8px;
  margin-top: 14px;
  padding-top: 10px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 6px;
  color: #b9adf5;
  font-weight: 600;
}

/* ---- Menus & bars ----------------------------------------------------- */
QMenuBar { background-color: #1a1a22; color: #ededf5; }
QMenuBar::item { padding: 4px 10px; background: transparent; border-radius: 5px; }
QMenuBar::item:selected { background-color: #34334a; }
QMenu {
  background-color: #262633;
  color: #ededf5;
  border: 1px solid #3f3f53;
  border-radius: 8px;
  padding: 6px;
}
QMenu::item { padding: 5px 24px 5px 10px; border-radius: 5px; }
QMenu::item:selected { background-color: #3c3a5e; color: #ffffff; }
QMenu::item:disabled { color: #5a5a72; }
QMenu::separator { height: 1px; background: #3a3a4a; margin: 4px 8px; }
QMenu::icon { padding-left: 6px; }

/* ---- Tool bar ---------------------------------------------------------- */
QToolBar { background-color: #1f1f2a; border-bottom: 1px solid #32323f; spacing: 2px; padding: 3px; }
QToolBar::separator { width: 1px; background: #3a3a4a; margin: 2px 6px; }

/* ---- Status bar -------------------------------------------------------- */
QStatusBar {
  background-color: #1f1f2a;
  border-top: 1px solid #32323f;
  color: #9a9ab0;
}
QStatusBar QLabel { color: #9a9ab0; }
QStatusBar QPushButton { background: transparent; border: none; color: #b0a5f2; padding: 2px 6px; }
QStatusBar QPushButton:hover { background-color: #34334a; border-radius: 5px; }

/* ---- Tabs -------------------------------------------------------------- */
QTabWidget::pane { border: 1px solid #32323f; background-color: #1f1f2a; border-radius: 6px; }
QTabBar::tab {
  background: transparent;
  color: #9a9ab0;
  padding: 6px 16px;
  border-bottom: 2px solid transparent;
  margin-right: 4px;
}
QTabBar::tab:hover { color: #ededf5; }
QTabBar::tab:selected { color: #b0a5f2; font-weight: 600; border-bottom: 2px solid #8b7be8; }

/* ---- Lists & tables ----------------------------------------------------- */
QListWidget, QTreeView, QTableView, QListView {
  background-color: #23232f;
  alternate-background-color: #20202a;
  border: 1px solid #32323f;
  border-radius: 6px;
  outline: none;
}
QListWidget::item, QTreeView::item, QTableView::item { padding: 4px 6px; }
QListWidget::item:hover, QTreeView::item:hover, QTableView::item:hover {
  background-color: #33324c;
}
QListWidget::item:selected, QTreeView::item:selected, QTableView::item:selected {
  background-color: #43406a;
  color: #ffffff;
}
QHeaderView::section {
  background-color: #2a2a36;
  color: #b9adf5;
  border: none;
  border-right: 1px solid #32323f;
  border-bottom: 1px solid #3f3f53;
  padding: 5px 8px;
  font-weight: 600;
}

/* ---- Misc surfaces ------------------------------------------------------- */
QDockWidget { color: #ededf5; }
QDockWidget::title {
  background-color: #2a2a36;
  padding: 6px 10px;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
}
QSplitter::handle { background-color: #32323f; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }

QToolTip {
  background-color: #f2f0fb;
  color: #2a2438;
  border: 1px solid #c9c0ee;
  padding: 4px 8px;
  border-radius: 4px;
}

/* Scrollbars: slim, tinted thumb */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #4a4470; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #5d55a0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #4a4470; border-radius: 4px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #5d55a0; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* Progress */
QProgressBar {
  background-color: #2c2c3a;
  border: none;
  border-radius: 5px;
  text-align: center;
  min-height: 12px;
}
QProgressBar::chunk { background-color: #8b7be8; border-radius: 5px; }

/* Links */
QLabel a { color: #a89bff; }
QLabel a:hover { text-decoration: underline; }
